#include <iostream>
using namespace std;
int main() {
    float s1, s2, s3, s4, s5, total, average, percentage;
    cout << "Enter marks of 5 subjects: ";
    cin >> s1 >> s2 >> s3 >> s4 >> s5;
    total = s1 + s2 + s3 + s4 + s5;
    average = total / 5;
    percentage = (total / 500) * 100;
    cout << "Total = " << total << endl;
    cout << "Average = " << average << endl;
    cout << "Percentage = " << percentage << "%";
    return 0;
}