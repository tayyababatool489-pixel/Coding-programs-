#include <iostream>
using namespace std;
int main() {
    float length, width, height, volume, litres;
    cout << "Enter length, width, height (in meters): ";
    cin >> length >> width >> height;
    volume = length * width * height;
    litres = volume * 1000;
    cout << "Volume = " << volume << " cubic meters" << endl;
    cout << "Capacity = " << litres << " litres";
    return 0;
}